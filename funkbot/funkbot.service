# Run FunkBot as a service.
#   sudo cp funkbot.service /etc/systemd/system/
#   sudo systemctl enable --now funkbot
#
# Edit User/WorkingDirectory to match your box. Requires the model server
# (ollama.service or your llama.cpp unit) to be running.

[Unit]
Description=FunkBot offline agent
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/funkbot
Environment="FUNKBOT_MODEL=qwen3:32b"
Environment="FUNKBOT_BASE_URL=http://localhost:11434/v1"
Environment="FUNKBOT_DATA=/opt/funkbot/data"
# Unattended service: permission prompts have nobody to answer them, so
# anything policy marks "ask" is refused rather than auto-run.
Environment="FUNKBOT_UNATTENDED=deny"
ExecStart=/usr/bin/python3 /opt/funkbot/server.py
Restart=on-failure
RestartSec=5

# It has shell access by design — keep the blast radius small.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/funkbot

[Install]
WantedBy=multi-user.target
